# Neon: copie a connection string do painel (Connection Details, com sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Segredo para assinar JWT e códigos MFA (mínimo 32 caracteres aleatórios)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Envio dos códigos MFA por SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente (no Office 365 deve ser o mesmo e-mail de SMTP_USER)
MAIL_FROM=Inventário Móvel <usuario@seudominio.com.br>
# Alternativa ao SMTP: se SMTP_HOST estiver vazio e houver RESEND_API_KEY, usa o Resend
RESEND_API_KEY=

# Domínios de e-mail permitidos para usuários do sistema (separados por vírgula; padrão: rttshop.com.br)
ALLOWED_EMAIL_DOMAINS=rttshop.com.br

# Primeiro administrador (usado apenas por `npm run migrate`, se ainda não houver admin)
ADMIN_EMAIL=higor.cunha@rttshop.com.br
ADMIN_NAME=Higor Cunha
ADMIN_PASSWORD=
