# Neon: copie a connection string do painel (Connection Details, com sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Segredo para assinar JWT e códigos MFA (mínimo 32 caracteres aleatórios)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Envio dos códigos MFA (Resend: https://resend.com). O domínio do remetente precisa estar verificado.
RESEND_API_KEY=
MAIL_FROM=Inventário Móvel <no-reply@seudominio.com.br>

# Primeiro administrador (usado apenas por `npm run migrate`, se ainda não houver admin)
ADMIN_EMAIL=higor.cunha@rttshop.com.br
ADMIN_NAME=Higor Cunha
ADMIN_PASSWORD=
